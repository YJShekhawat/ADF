{
	"name": "DelimitedText3",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorageVSS",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"schemaName": {
				"type": "string"
			},
			"tableName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().tableName,'.csv')",
